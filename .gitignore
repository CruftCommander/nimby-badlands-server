# Secrets and local overrides - never commit
.env
*.env
secrets/
*.local.cfg
*.local.json

# Server runtime output pulled down for inspection
logs/
*.RPT
*.ADM
*.log
storage_*/

# Workshop downloads and tooling caches
steamcmd/
workshop-cache/
*.bikey.tmp

# OS and editor
Thumbs.db
.DS_Store
.vs/
.vscode/

# Third-party Workshop downloads copied for extraction - never committed
vendor/

# Signing keys - private keys never enter the repo
*.biprivatekey

# Built mod output - rebuilt from source, never committed
build/

# Reusable local test-server profiles (Start-NimbyTestServer.ps1 -ProfileName) - runtime state, never committed
profiles/

# NimbyDpv built model and textures - derived from a licensed model source (shared rules 9.3
# exception, docs/design/dpv-feasibility.md D-2); copied in from D:\DayZProjects\NimbyDpv\data before a build, never committed
mods/own/nimby-pack/NimbyDpv/data/

# Python bytecode from the DPV model builder (scripts/dpv/)
__pycache__/

# NimbyTapes Phase 0 timing tracks - generated by NimbyTapes\tools\New-TimingTrack.ps1 into sound\
# (Plan 13, P4). No audio file is ever committed
mods/own/nimby-pack/NimbyTapes/sound/*.ogg
