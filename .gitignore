# Secrets and local overrides - never commit
.env
*.env
secrets/
*.local.cfg
*.local.json

# Server runtime output pulled down for inspection
logs/
*.RPT
*.ADM
*.log
storage_*/

# Workshop downloads and tooling caches
steamcmd/
workshop-cache/
*.bikey.tmp

# OS and editor
Thumbs.db
.DS_Store
.vs/
.vscode/

# Third-party Workshop downloads copied for extraction - never committed
vendor/

# Signing keys - private keys never enter the repo
*.biprivatekey

# Built mod output - rebuilt from source, never committed
build/

# Reusable local test-server profiles (Start-NimbyTestServer.ps1 -ProfileName) - runtime state, never committed
profiles/
