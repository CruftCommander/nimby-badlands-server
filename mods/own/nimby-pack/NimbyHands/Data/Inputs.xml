<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!--
  Hands key bindings (shared rules 5; Hands plan G2).
  UANimbyHandsOfferRequest defaults to O: bin/constants.xml:482 declares kO and
  bin/preset_X1MouseKey.xml binds nothing to it, so a plain press is free in vanilla 1.30.
  UANimbyHandsTogglePockets ships unbound (G2, decided October 15, 2026): the October 14 Left
  Shift + O combo also fired the offer input (NIMBY-T-002), and the 1.30 input API has no way
  to make one input ignore a press while a modifier is held (UAInput.c:33-103). The player
  binds it under the label below.
  Both sort into the vanilla Others tab (bin/constants.xml:915), where the player rebinds
  them; a new <sorting> group is not honored on 1.30 (Ears EP-005, October 17, 2026).
  Renamed from UANimbyOfferRequestItem and UANimbyTogglePocketAccess on October 19, 2026:
  players who changed O rebind it once.
-->
<modded_inputs>
    <inputs>
        <actions>
            <input name="UANimbyHandsOfferRequest" loc="Hands: offer or request item" />
            <input name="UANimbyHandsTogglePockets" loc="Hands: open or close pockets" />
        </actions>
    </inputs>
    <sorting name="others" loc="layout_pc_keybinding_others">
        <input name="UANimbyHandsOfferRequest" />
        <input name="UANimbyHandsTogglePockets" />
    </sorting>
    <preset>
        <input name="UANimbyHandsOfferRequest">
            <btn name="kO" />
        </input>
    </preset>
</modded_inputs>
