<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<modded_inputs>
    <inputs>
        <actions>
            <input name="UANimbyOfferRequestItem" loc="#STR_NIMBY_GT_OFFER_REQUEST_ITEM" />
            <input name="UANimbyTogglePocketAccess" loc="#STR_NIMBY_GT_TOGGLE_ALLOW_PUT_IN_POCKETS" />
        </actions>
    </inputs>
    <preset>
        <input name="UANimbyOfferRequestItem">
            <btn name="kO" />
        </input>
        <!-- Hold Left Shift, press O. Nested btn = hold outer, press inner; same form vanilla uses
             for hold Left Control + X (UABuldUndo) while X alone is bound elsewhere. -->
        <input name="UANimbyTogglePocketAccess">
            <btn name="kLShift">
                <btn name="kO" />
            </btn>
        </input>
    </preset>
</modded_inputs>