{
    "modFolderName": "@NIMBY",
    "modName": "NIMBY",
    "author": "Jeff Fabish",
    "keyAuthority": "nimby",
    "includePatterns": [
        "*.c",
        "*.cpp",
        "*.h",
        "*.hpp",
        "*.xml",
        "*.csv",
        "*.json",
        "*.layout",
        "*.txt",
        "LICENSE",
        "NOTICE"
    ],
    "addons": [
        {
            "folder": "NimbyAutorun",
            "pboName": "NimbyAutorun",
            "prefix": "NimbyAutorun"
        },
        {
            "folder": "NimbyGiveTake",
            "pboName": "NimbyGiveTake",
            "prefix": "NimbyGiveTake"
        },
        {
            "folder": "NimbyEarplugs",
            "pboName": "NimbyEarplugs",
            "prefix": "NimbyEarplugs"
        }
    ],
    "dev": {
        "folder": "../dev/NimbyDevHarness",
        "pboName": "NimbyDevHarness",
        "prefix": "NimbyDevHarness",
        "keyAuthority": "nimby_dev"
    },
    "bootCheck": {
        "mission": "dayzOffline.nasdara",
        "port": 2402,
        "instanceId": 999,
        "timeoutSeconds": 240,
        "selfTestGraceSeconds": 20,
        "failurePatterns": [
            "SCRIPT\\s*\\(E\\)",
            "Can't compile",
            "Cannot open file",
            "Unknown type",
            "Undefined function",
            "Scripted variables corrupted",
            "\\[NIMBY\\]\\[[^\\]]+\\]\\[SelfTest\\] FAIL"
        ],
        "readyPatterns": [
            "Init sequence finished",
            "Mission read"
        ]
    },
    "testServer": {
        "mission": "dayzOffline.nasdara",
        "port": 2302,
        "instanceId": 998,
        "maxPlayers": 4,
        "hostname": "NIMBY local test - not public"
    }
}
