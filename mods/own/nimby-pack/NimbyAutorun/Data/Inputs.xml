<!--
  Legs key binding (shared rules 5, Legs plan A1 and A3).
  Default: double tap Left Shift. kLShift is bin/constants.xml:500. Vanilla holds kLShift for
  UATurbo (bin/preset_X1MouseKey.xml:21-23); a doubleclick event on a key vanilla uses as a hold
  does not shadow the hold, and vanilla does the same with UAWalkRunToggle, a doubleclick on
  kLControl beside the UAWalkRunTemp hold (bin/preset_X1MouseKey.xml:24-31). The doubleclick limit
  on the PC keyboard is 0.5 s (bin/constants.xml:457). Kept in mind for the in-game check: Left
  Shift also carries UAADSToggle as a click (:169-172), which acts only with the weapon raised.
  Sorting: the <sorting> block sits INSIDE <inputs>, beside <actions>, the way vanilla
  bin/constants.xml:1-937 nests it. The October 17, 2026 attempts (Ears EP-005, E11) put the
  block beside <inputs> under <modded_inputs>, and 1.30 ignored it; Bohemia tracker T165909
  reports the same symptom resolved by this nesting. Group "nimby" is declared in every NIMBY
  addon with the same name and label, since each addon releases on its own; whether 1.30 merges
  the three declarations into one tab, shows one tab per addon, or clips the tab strip is what
  the October 20, 2026 Controls check decides (NIMBY-T-007). If the tab does not appear, the
  fallback is the vanilla "others" group with this same nesting.
-->
<modded_inputs>
    <inputs>
        <actions>
            <input name="UANimbyAutorunToggle" loc="Legs: toggle autorun" />
        </actions>
        <sorting name="nimby" loc="NIMBY">
            <input name="UANimbyAutorunToggle" />
        </sorting>
    </inputs>
    <preset>
        <input name="UANimbyAutorunToggle">
            <btn name="kLShift">
                <event name="doubleclick" />
            </btn>
        </input>
    </preset>
</modded_inputs>
